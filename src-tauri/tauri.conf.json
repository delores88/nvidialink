{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DGXBridge",
  "version": "0.2.0",
  "identifier": "com.deloresai.dgxbridge",
  "build": {"frontendDist": "../ui"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"title":"DGXBridge","width":1140,"height":790,"minWidth":850,"minHeight":650,"backgroundColor":"#111915"}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DeloresAI",
    "category": "DeveloperTool",
    "shortDescription": "Build on your laptop and NVIDIA DGX Spark from one job board.",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/icon.ico"],
    "resources": {"../dist/bin/":"bin/","../dist/sparkdev-bundle.json":"sparkdev-bundle.json","../remote/bootstrap.py":"bootstrap.py","../LICENSE":"LICENSE","../dist/notices/":"notices/","../ui/vendor/QRCODE-LICENSE.txt":"notices/QRCODE-LICENSE.txt","../ui/vendor/PHASEFORGE-AUTHOR-NOTICE.txt":"notices/PHASEFORGE-AUTHOR-NOTICE.txt"},
    "windows": {
      "webviewInstallMode": {"type":"skip"},
      "nsis": {"installMode":"currentUser","displayLanguageSelector":false,"installerIcon":"icons/icon.ico","startMenuFolder":"DeloresAI"}
    }
  }
}

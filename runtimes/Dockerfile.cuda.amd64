# Independent AMD64 compute runtime; no ARM64 Blender files or image are reused.
# This child manifest was verified under NVIDIA's immutable PyTorch 25.09 index.
FROM nvcr.io/nvidia/pytorch@sha256:4bf906c628d572681a977681765a44a3c1d7e34b39633b7160a84de707608139
LABEL org.opencontainers.image.title="DGXBridge AMD64 CUDA runtime" \
      org.opencontainers.image.description="PyTorch CUDA compute; AMD64 Blender is not provisioned"
ADD https://files.pythonhosted.org/packages/e6/99/fdf65cc539e266ab93546c261bdf98411fe165c6e4e13f9dbf597097192b/pillow-13.0.0-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl /opt/sparkdev/wheels/
RUN printf '%s\n' 'pillow==13.0.0 --hash=sha256:42d63be3af4f9b951b199b0a9d23365d37ab14687e6d77b74940432c8515c4ca' > /opt/sparkdev/pillow-requirements.txt \
 && /usr/bin/python3 -m pip install --no-cache-dir --disable-pip-version-check --no-index --find-links=/opt/sparkdev/wheels --require-hashes --only-binary=:all: --no-deps --force-reinstall --break-system-packages -r /opt/sparkdev/pillow-requirements.txt
RUN /usr/bin/python3 -c 'import site,pip,torch; assert site.ENABLE_USER_SITE'
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*
COPY media_probe.py /opt/sparkdev/media_probe.py
RUN chmod 0755 /opt/sparkdev && chmod 0644 /opt/sparkdev/media_probe.py
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,video PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /work
ENTRYPOINT ["/usr/bin/python3"]
